{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-dispo-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-trial-expiration",
      "schedule": "0 9 * * *"
    }
  ]
}
